{
  "name": "aegis-qa",
  "version": "1.0.0",
  "description": "Aegis QA - Advanced quality assurance orchestrator with hardware protection and AI-powered analysis",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "aegis:review": "node dist/cli.js review ."
  },
  "keywords": [
    "qa",
    "orchestrator",
    "quality-assurance",
    "hardware-protection",
    "ai",
    "security",
    "code-analysis"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "@supabase/supabase-js": "^2.103.0",
    "dotenv": "^17.4.1",
    "fs-extra": "^11.2.0",
    "glob": "^13.0.6",
    "systeminformation": "^5.31.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@vitest/ui": "^4.1.4",
    "eslint": "^10.2.0",
    "prettier": "^3.8.1",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^4.1.4"
  }
}
